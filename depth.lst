MACRO      WRITE_CRTC                   1 macro WRITE_CRTC reg, val
                                        2 		ld bc, 0xbc00 + {reg} : out (c), c
                                        3 		ld bc, 0xbd00 + {val} : out (c), c
                                        4 	endm
MACRO      BORDER                       7 macro BORDER val
                                        8 		if DEBUG_MODE
                                        9 			ld bc, 0x7f10:out(c), c : ld bc, 0x7f00 + {val} : out (c), c
                                       10 		else
                                       11 			ld bc, 0x7f10:out(c), c : ld bc, 0x7f10 : out (c), c
                                       12 		endif
                                       13 	endm
