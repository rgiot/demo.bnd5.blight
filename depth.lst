                                     1090         IFNDEF PLY_AKG_Rom
                                     1091 PLY_AKG_Channel{channelNumber}_InstrumentOriginalSpeed ld a,0
                                     1092         ELSE
                                     1093         ld a,(PLY_AKG_Channel{channelNumber}_InstrumentOriginalSpeed)
                                     1094         ENDIF
                                     1095         ld (PLY_AKG_Channel{channelNumber}_InstrumentSpeed + PLY_AKG_Offset1b),a
                                     1096                         ENDIF ;PLY_CFG_UseEffect_ForceInstrumentSpeed
                                     1097 
