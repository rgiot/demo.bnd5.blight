                                     1056                         ELSE
                                     1057                                 ld (PLY_AKG_Channel{channelNumber}_InstrumentSpeed + PLY_AKG_Offset1b),a
                                     1058                         ENDIF ;PLY_CFG_UseEffect_ForceInstrumentSpeed
                                     1059                 ld (PLY_AKG_Channel{channelNumber}_PtInstrument + PLY_AKG_Offset1b),hl
                                     1060                 ld (PLY_AKG_Channel{channelNumber}_PtBaseInstrument + PLY_AKG_Offset1b),hl   ;Useful when playing another note with the same instrument.
                                     1061         exx
                                     1062 PLY_AKG_Channel{channelNumber}_AfterInstrument:
                                     1063 
                                     1064         ;There is a new note. The instrument pointer has already been reset.
                                     1065         ;-------------------------------------------------------------------
                                     1066         ;Instrument number is set.
                                     1067         ;Arpeggio and Pitch Table are reset.
                                     1068 
                                     1069         ;HL must be preserved! But it is faster to use HL than DE when storing 16 bits value.
                                     1070         ;So it is stored in DE for now.
                                     1071         ex de,hl
