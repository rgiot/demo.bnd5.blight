                                     1099         ld a,PLY_AKG_OPCODE_OR_A
                                     1100         ld (PLY_AKG_Channel{channelNumber}_IsPitch),a
                                     1101                         ENDIF ;PLY_AKS_UseEffect_PitchUpOrDown
                                     1102 
