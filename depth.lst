MACRO      DecompressZX0               45 macro DecompressZX0
                                       46 
                                       47         ld      ix, @CopyMatch1
                                       48         ld      bc, $ffff
                                       49         ld      (@PrevOffset+1), bc      ; default offset is -1
                                       50         inc     bc
                                       51         ld      a, $80
                                       52         jr      @RunOfLiterals           ; BC is assumed to contains 0 most of the time
                                       53 
                                       54 @ShorterOffsets:
                                       55         ld      b, $ff                  ; the top byte of the offset is always $FF
                                       56         ld      c, (hl)
                                       57         inc     hl
                                       58         rr      c
                                       59         ld      (@PrevOffset+1), bc
                                       60         jr      nc, @LongerMatch
                                       61 
                                       62 @CopyMatch2:                             ; the case of matches with len=2
                                       63         ld      bc, 2
                                       64 
                                       65         ; the faster match copying code
                                       66 @CopyMatch1:
                                       67         push    hl                      ; preserve source
                                       68 
                                       69 @PrevOffset:
                                       70         ld      hl, $ffff               ; restore offset (default offset is -1)
                                       71         add     hl, de                  ; HL = dest - offset
                                       72         ldir
                                       73         pop     hl                      ; restore source
                                       74 
                                       75         ; after a match you can have either
                                       76         ; 0 + <elias length> = run of literals, or
                                       77         ; 1 + <elias offset msb> + [7-bits of offset lsb + 1-bit of length] + <elias length> = another match
                                       78 @AfterMatch1:
                                       79         add     a, a
                                       80         jr      nc, @RunOfLiterals
                                       81 
                                       82 @UsualMatch:                             ; this is the case of usual match+offset
                                       83         add     a, a
                                       84         jr      nc, @LongerOffets
                                       85         jr      nz, @ShorterOffsets      ; NZ after NC == "confirmed C"
                                       86         
                                       87         ld      a, (hl)                 ; reload bits
                                       88         inc     hl
                                       89         rla
                                       90 
                                       91         jr      c, @ShorterOffsets
                                       92 
                                       93 @LongerOffets:
                                       94         ld      c, $fe
                                       95 
                                       96         add     a, a                    ; inline read gamma
                                       97         rl      c
                                       98         add     a, a
                                       99         jr      nc, $-4
                                      100 
                                      101         call    z, @ReloadReadGamma
                                      102 
                                      103 @ProcessOffset:
                                      104 
                                      105         inc     c
                                      106         ret     z                       ; end-of-data marker (only checked for longer offsets)
                                      107         rr      c
                                      108         ld      b, c
                                      109         ld      c, (hl)
                                      110         inc     hl
                                      111         rr      c
                                      112         ld      (@PrevOffset+1), bc
                                      113 
                                      114         ; lowest bit is the first bit of the gamma code for length
                                      115         jr      c, @CopyMatch2
                                      116 
                                      117 @LongerMatch:
                                      118         ld      bc, 1
                                      119 
                                      120         add     a, a                    ; inline read gamma
                                      121         rl      c
                                      122         add     a, a
                                      123         jr      nc, $-4
                                      124 
                                      125         call    z,@ReloadReadGamma
                                      126 
                                      127 @CopyMatch3:
                                      128         push    hl                      ; preserve source
                                      129         ld      hl, (@PrevOffset+1)      ; restore offset
                                      130         add     hl, de                  ; HL = dest - offset
                                      131 
                                      132         ; because BC>=3-1, we can do 2 x LDI safely
                                      133         ldi
                                      134         ldir
                                      135         inc     c
                                      136         ldi
                                      137         pop     hl                      ; restore source
                                      138 
                                      139         ; after a match you can have either
                                      140         ; 0 + <elias length> = run of literals, or
                                      141         ; 1 + <elias offset msb> + [7-bits of offset lsb + 1-bit of length] + <elias length> = another match
                                      142 @AfterMatch3:
                                      143         add     a, a
                                      144         jr      c, @UsualMatch
                                      145 
                                      146 @RunOfLiterals:
                                      147         inc     c
                                      148         add     a, a
                                      149         jr      nc, @LongerRun
                                      150         jr      nz, @CopyLiteral         ; NZ after NC == "confirmed C"
                                      151         
                                      152         ld      a, (hl)                 ; reload bits
                                      153         inc     hl
                                      154         rla
                                      155 
                                      156         jr      c, @CopyLiteral
                                      157 
                                      158 @LongerRun:
                                      159         add     a, a                    ; inline read gamma
                                      160         rl      c
                                      161         add     a, a
                                      162         jr      nc, $-4
                                      163 
                                      164         jr      nz, @CopyLiterals
                                      165         
                                      166         ld      a, (hl)                 ; reload bits
                                      167         inc     hl
                                      168         rla
                                      169 
                                      170         call    nc, @ReadGammaAligned
                                      171 
                                      172 @CopyLiterals:
                                      173         ldi
                                      174 
                                      175 @CopyLiteral:
                                      176         ldir
                                      177 
                                      178         ; after a literal run you can have either
                                      179         ; 0 + <elias length> = match using a repeated offset, or
                                      180         ; 1 + <elias offset msb> + [7-bits of offset lsb + 1-bit of length] + <elias length> = another match
                                      181         add     a, a
                                      182         jr      c, @UsualMatch
                                      183 
                                      184 @RepMatch:
                                      185         inc     c
                                      186         add     a, a
                                      187         jr      nc, @LongerRepMatch
                                      188         jr      nz, @CopyMatch1          ; NZ after NC == "confirmed C"
                                      189 
                                      190         ld      a, (hl)                 ; reload bits
                                      191         inc     hl
                                      192         rla
                                      193 
                                      194         jr      c, @CopyMatch1
                                      195 
                                      196 @LongerRepMatch:
                                      197         add     a, a                    ; inline read gamma
                                      198         rl      c
                                      199         add     a, a
                                      200         jr      nc, $-4
                                      201 
                                      202         jp      nz, @CopyMatch1
                                      203 
                                      204         ; this is a crafty equivalent of CALL ReloadReadGamma : JP CopyMatch1
                                      205         push    ix
                                      206 
                                      207         ;  the subroutine for reading the remainder of the partly read Elias gamma code.
                                      208         ;  it has two entry points: ReloadReadGamma first refills the bit reservoir in A,
                                      209         ;  while ReadGammaAligned assumes that the bit reservoir has just been refilled.
                                      210 @ReloadReadGamma:
                                      211         ld      a, (hl)                 ; reload bits
                                      212         inc     hl
                                      213         rla
                                      214 
                                      215         ret     c
                                      216 @ReadGammaAligned:
                                      217         add     a, a
                                      218         rl      c
                                      219         add     a, a
                                      220         ret     c
                                      221         add     a, a
                                      222         rl      c
                                      223         add     a, a
                                      224 @ReadingLongGamma:                       ; this loop does not need unrolling, as it does not get much use anyway
                                      225         ret     c
                                      226         add     a, a
                                      227         rl      c
                                      228         rl      b
                                      229         add     a, a
                                      230         jr      nz, @ReadingLongGamma
                                      231 
                                      232         ld      a, (hl)                 ; reload bits
                                      233         inc     hl
                                      234         rla
                                      235         jr      @ReadingLongGamma
                                      236 mend
