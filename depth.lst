C00B 1C00B                             33 ;;
C00B 1C00B                             34 ; Wait by injecting nops or jumping
MACRO      LOGO_WAIT                   35 macro LOGO_WAIT amount
                                       36 	assert {amount} >= 0
                                       37 	assert {amount} <= 64
                                       38 	if {amount} < LOGO_SPLIT_RASTER_MIN_WAIT_TIME_WITH_CALL
                                       39 		if {amount} != 0
                                       40 			defs {amount}, 0
                                       41 		endif
                                       42 	else
                                       43 
                                       44 		call wait_code.ret - ({amount} - LOGO_SPLIT_RASTER_MIN_WAIT_TIME_WITH_CALL)
                                       45 	endif
                                       46 
                                       47 	_logo_routine_count_ += {amount}
                                       48 endm
C00B 1C00B                             50 ;;
C00B 1C00B                             51 ; to be call to encode the beginning of a line
MACRO      LOGO_SPLIT_RASTER_START_LINE  52 macro LOGO_SPLIT_RASTER_START_LINE
                                       53 	_logo_routine_count_ = duration(call 0) + duration(ret)
                                       54 endm
C00B 1C00B                             56 ;;
C00B 1C00B                             57 ; to be called to encode the end of a line of the split raster effect
MACRO      LOGO_SPLIT_RASTER_WAIT_EOL  58 macro LOGO_SPLIT_RASTER_WAIT_EOL
                                       59 	print "Raster routine count", _logo_routine_count_, " wait ", (64 - _logo_routine_count_)
                                       60 	; The 64 nops include
                                       61 	; - the call to the routine
                                       62 	; - the true routine code
                                       63 	; - the call to the wait
                                       64 	; - the ret
                                       65 	; TODO use jp to wait
                                       66 	LOGO_WAIT( {eval}(64 - _logo_routine_count_))
                                       67 	undef _logo_routine_count_
                                       68 	ret
                                       69 endm
C00B 1C00B                             71 ;;
C00B 1C00B                             72 ; to be called to encode the end of a line of the split raster effect
MACRO      LOGO_SPLIT_BORDER_CLEANUP_AND_WAIT_EOL  73 macro LOGO_SPLIT_BORDER_CLEANUP_AND_WAIT_EOL
                                       74 	; ensure split border is off
                                       75 	LOGO_BACKGROUND()
                                       76 
                                       77 
                                       78 	; ensure color of border is correct
                                       79 	ticker start inner_duration
                                       80 		exx  ; we switch to the color backup
                                       81 		out (c), d ; we change border color to black
                                       82 	ticker stop
                                       83 	_logo_routine_count_ += inner_duration
                                       84 	undef inner_duration
                                       85 
                                       86 	print "Border routine count", _logo_routine_count_, " wait ", (64 - _logo_routine_count_)
                                       87 	; The 64 nops include
                                       88 	; - the call to the routine
                                       89 	; - the true routine code
                                       90 	; - the call to the wait
                                       91 	; - the ret
                                       92 	; TODO use jp to wait
                                       93 	LOGO_WAIT( {eval}(64 - _logo_routine_count_))
                                       94 	undef _logo_routine_count_
                                       95 	ret
                                       96 endm
C00B 1C00B                             98 ;;
C00B 1C00B                             99 ; request a foreground display
C00B 1C00B                            100 ; - for the zone with split-raster in border it changes the ink to the selected foreground ink
C00B 1C00B                            101 ; - for the zone with split-border in the pixels, it activates border
MACRO      LOGO_FOREGROUND            102 macro LOGO_FOREGROUND
                                      103 	out (c), e
                                      104 	_logo_routine_count_ += duration(out (c), e)
                                      105 endm
C00B 1C00B                            107 ;;
C00B 1C00B                            108 ; request a background display
C00B 1C00B                            109 ; - for the zone with split-raster in border it changes the ink to the standard border ink
C00B 1C00B                            110 ; - for the zone with split-border in the pixels, it activates pixels display
MACRO      LOGO_BACKGROUND            111 macro LOGO_BACKGROUND
                                      112 	out (c), d
                                      113 	_logo_routine_count_ += duration(out (c), d)
                                      114 endm
C00B 1C00B                            117 ;;
C00B 1C00B                            118 ; Make the necessary to have border inside the pixel of a different color that the border outside of the pixel aea
MACRO      LOGO_SPLIT_BORDER_START_ROUTINE 119 macro LOGO_SPLIT_BORDER_START_ROUTINE
                                      120 	BREAKPOINT condition="B<>0x7f"
                                      121 	BREAKPOINT condition="D<>0x54"
                                      122 	ticker start inner_duration
                                      123 		out (c), e ; we change border color to something else than black
                                      124 		exx  ; we switch the the split border registers
                                      125 	ticker stop
                                      126 	_logo_routine_count_ = duration(call 0) + duration(ret) +  inner_duration
                                      127 	undef inner_duration
                                      128 
                                      129 	; TODO Add a breakpoint for a specific C0 value
                                      130 endm
