MACRO      PLY_AKG_ReadTrack          927 MACRO PLY_AKG_ReadTrack channelNumber
                                      928 
                                      929         IFNDEF PLY_AKG_Rom
                                      930 PLY_AKG_Channel{channelNumber}_WaitCounter: ld a,0      ;Lines to wait?
                                      931         ELSE
                                      932         ld a,(PLY_AKG_Channel{channelNumber}_WaitCounter)
                                      933         ENDIF
                                      934         sub 1
                                      935         jr c,PLY_AKG_Channel{channelNumber}_ReadTrack
                                      936         ;Still some lines to wait.
                                      937         ld (PLY_AKG_Channel{channelNumber}_WaitCounter + PLY_AKG_Offset1b),a
                                      938         jp PLY_AKG_Channel{channelNumber}_ReadCellEnd
                                      939 
                                      940 PLY_AKG_Channel{channelNumber}_ReadTrack:
                                      941         IFNDEF PLY_AKG_Rom
                                      942 dknr3 (void):
                                      943 PLY_AKG_Channel{channelNumber}_PtTrack: ld hl,0      ;Points on the Cell to read.
                                      944         ELSE
                                      945         ld hl,(PLY_AKG_Channel{channelNumber}_PtTrack)
                                      946         ENDIF
                                      947         ;Reads note data. It can be a note, a wait...
                                      948 
                                      949         ld c,(hl)       ;C = data (b5-0) + effect? (b6) + new Instrument? (b7).
                                      950         inc hl
                                      951         ld a,c
                                      952         and %111111     ;A = data.
                                      953         cp 60           ;0-59: note. "cp" is preferred to "sub" so that the "note" branch (the slowest) is note-ready.
                                      954         jr c,PLY_AKG_Channel{channelNumber}_Note
                                      955         sub 60
                                      956         jp z,PLY_AKG_Channel{channelNumber}_MaybeEffects        ;60 = no note, but maybe effects.
                                      957         dec a
                                      958         jr z,PLY_AKG_Channel{channelNumber}_Wait                ;61 = wait, no effect.
                                      959         dec a
                                      960         jr z,PLY_AKG_Channel{channelNumber}_SmallWait           ;62 = small wait, no effect.
                                      961         ;63 = escape code for note, maybe effects.
                                      962         ;Reads the note in the next byte (HL has already been incremented).
                                      963         ld a,(hl)
                                      964         inc hl
                                      965         jr PLY_AKG_Channel{channelNumber}_AfterNoteKnown
                                      966 
                                      967         ;Small wait, no effect.
                                      968 PLY_AKG_Channel{channelNumber}_SmallWait:
                                      969         ld a,c          ;Uses bit 6/7 to indicate how many lines to wait.
                                      970         rlca
                                      971         rlca
                                      972         and %11
                                      973         inc a         ;This wait start at 2 lines, to 5.
                                      974         ld (PLY_AKG_Channel{channelNumber}_WaitCounter + PLY_AKG_Offset1b),a
                                      975         jr PLY_AKG_Channel{channelNumber}_BeforeEnd_StoreCellPointer
                                      976 
                                      977         ;Wait, no effect.
                                      978 PLY_AKG_Channel{channelNumber}_Wait:
                                      979         ld a,(hl)   ;Reads the wait value on the next byte (HL has already been incremented).
                                      980         ld (PLY_AKG_Channel{channelNumber}_WaitCounter + PLY_AKG_Offset1b),a
                                      981         inc hl
                                      982         jr PLY_AKG_Channel{channelNumber}_BeforeEnd_StoreCellPointer
                                      983 
                                      984         ;Little subcode put here, called just below. A bit dirty, but avoids long jump.
                                      985 PLY_AKG_Channel{channelNumber}_SameInstrument:
                                      986         ;No new instrument. The instrument pointer must be reset.
                                      987         IFNDEF PLY_AKG_Rom
                                      988 dknr3 (void):
                                      989 PLY_AKG_Channel{channelNumber}_PtBaseInstrument: ld de,0
                                      990         ELSE
                                      991         ld de,(PLY_AKG_Channel{channelNumber}_PtBaseInstrument)
                                      992         ENDIF
                                      993         ld (PLY_AKG_Channel{channelNumber}_PtInstrument + PLY_AKG_Offset1b),de
                                      994         jr PLY_AKG_Channel{channelNumber}_AfterInstrument
                                      995 
                                      996         ;A note has been found, plus maybe an Instrument and effects. A = note. C = still has the New Instrument/Effects flags.
                                      997 PLY_AKG_Channel{channelNumber}_Note:
                                      998         if {channelNumber} == 1                 ;Declares this only for the first channel, else refers to it.
                                      999                 IFNDEF PLY_AKG_Rom
                                     1000 PLY_AKG_BaseNoteIndex: add a,0                  ;The encoded note is only from a 4 octave range, but the first note depends on he best window, determined by the song generator.
                                     1001                 ELSE
                                     1002                 ld b,a
                                     1003                 ld a,(PLY_AKG_BaseNoteIndex + PLY_AKG_Offset1b)
                                     1004                 add a,b
                                     1005                 ENDIF
                                     1006         else
                                     1007                 ld b,a
                                     1008                 ld a,(PLY_AKG_BaseNoteIndex + PLY_AKG_Offset1b)
                                     1009                 add a,b
                                     1010         endif
                                     1011 PLY_AKG_Channel{channelNumber}_AfterNoteKnown:
                                     1012                         IFDEF PLY_CFG_UseTranspositions                  ;CONFIG SPECIFIC
                                     1013                                 IFNDEF PLY_AKG_Rom
                                     1014 PLY_AKG_Channel{channelNumber}_Transposition: add a,0           ;Adds the Track transposition.
                                     1015                                 ELSE
                                     1016                                 ld b,a
                                     1017                                 ld a,(PLY_AKG_Channel{channelNumber}_Transposition + PLY_AKG_Offset1b)
                                     1018                                 add a,b
                                     1019                                 ENDIF
                                     1020                         ENDIF ;PLY_CFG_UseTranspositions
                                     1021         ld (PLY_AKG_Channel{channelNumber}_TrackNote + PLY_AKG_Offset1b),a
                                     1022 
                                     1023         ;HL = next data. C = data byte.
                                     1024         rl c                ;New Instrument?
                                     1025         jr nc,PLY_AKG_Channel{channelNumber}_SameInstrument
                                     1026         ;Gets the new Instrument.
                                     1027         ld a,(hl)
                                     1028         inc hl
                                     1029         exx
                                     1030         if {channelNumber} == 1               ;Declares this only for the first channel, else refers to it.
                                     1031                 ld l,a
                                     1032                 ld h,0
                                     1033                 add hl,hl
                                     1034                 IFNDEF PLY_AKG_Rom
                                     1035 dknr3 (void):
                                     1036 PLY_AKG_InstrumentsTable: ld de,0           ;Points on the Instruments table of the music (set on song initialization).
                                     1037                 ELSE
                                     1038                         ld de,(PLY_AKG_InstrumentsTable + PLY_AKG_Offset1b)
                                     1039                 ENDIF
                                     1040                 add hl,de
                                     1041         else
                                     1042                 ld e,a
                                     1043                 ld d,0
                                     1044                 ld hl,(PLY_AKG_InstrumentsTable + PLY_AKG_Offset1b)           ;Points on the Instruments table of the music (set on song initialization).
                                     1045                 add hl,de
                                     1046                 add hl,de
                                     1047         endif
                                     1048                 ld sp,hl
                                     1049                 pop hl
                                     1050 
                                     1051                 ld a,(hl)       ;Gets the speed.
                                     1052                 inc hl
                                     1053                         ;No need to store an "original speed" if "force instrument speed" effect is not used.
                                     1054                         IFDEF PLY_CFG_UseEffect_ForceInstrumentSpeed            ;CONFIG SPECIFIC
