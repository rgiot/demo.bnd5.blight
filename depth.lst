MACRO      DS_WAIT_MICROSEG            28 MACRO DS_WAIT_MICROSEG duration
                                       29 @k EQU {duration} - 1
                                       30 		LD   B,@k / 4                      ; (2 = 1 that we subtracted and 1 that is missing from the DJNZ)
                                       31 		DJNZ $                              ; (4 * [N - 1] + 3 = 4 * N - 1)
                                       32 		DEFS @k % 4                        ; (1 * [4 * N - 1] % 4)
                                       33 	ENDM
MACRO      DS_WRITE_CRTC               36 MACRO DS_WRITE_CRTC register, value
                                       37         LD   BC, &bc00 + {register}
                                       38         OUT  (C),C
                                       39         LD   BC, &bd00 + {value}
                                       40         OUT  (C),C
                                       41 ENDM
MACRO      DS_CRTC_HORIZONTAL_TRANSITION_ONLY  44 MACRO DS_CRTC_HORIZONTAL_TRANSITION_ONLY from, to
                                       45 @delta EQU ({to}) - ({from})
                                       46 		DS_WAIT_MICROSEG(__DS_HT_delay1)
