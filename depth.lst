                                     1085                         ENDIF ;PLY_CFG_UseEffect_PitchTable
                                     1086         ld (PLY_AKG_Channel{channelNumber}_InstrumentStep + PLY_AKG_Offset2b),a
                                     1087 
                                     1088                         ;If the "force instrument speed" effect is used, the instrument speed must be reset to its original value.
