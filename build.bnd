{% set MAIN_INKA=5 %}
{% set MAIN_INKB=14 %}

{% set SCREEN_MEMORY_FILES=["C4.4100", "C5.4000", "C6.4000", "C7.4000"]%}

{% macro convert_background_mode1(scr) %}
- tgt: {{scr}}
  dep: {{scr | replace(".scr", ".png")}}
  cmd: 
   - img2cpc $< --mode 1 --pens 26,0,{{MAIN_INKA}},{{MAIN_INKB}} scr --r1=32 --r6=32 -o $@
   - compress -i $@ -o $@.zx0 --cruncher zx0
   - compress -i $@ -o $@.lzsa2 --cruncher lzsa2
   - compress -i $@ -o $@.lz49 --cruncher lz49
{% endmacro %}

{#
{% macro convert_logo_mode1(spr) %}
- tgt: {{spr}}
  dep: {{spr | replace(".spr", ".png")}}
  cmd: 
   - img2cpc $< --mode 1 --pens 26,0,{{MAIN_INKA}},{{MAIN_INKB}} sprite -o $@
{% endmacro %}
#}

